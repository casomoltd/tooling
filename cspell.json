    "analyzed",
    "anymore",
    "backticked",
    "branchless",
    "Butterick",
    "Casomo",
    "casomoltd",
    "classmethod",
    "classmethods",
    "codegen",
    "Crawlable",
    "dataclass",
    "dataclasses",
    "DDEB",
    "dedup",
    "depcruise",
    "dialog",
    "docstrings",
    "EAFP",
    "elif",
    "frontmatter",
    "getitem",
    "Grotesk",
    "handoff",
    "htmlvalidate",
    "incl",
    "judgment",
    "judgments",
    "LBYL",
    "linted",
    "linters",
    "mockup",
    "offs",
    "pyproject",
    "pytest",
    "reauthor",
    "recomputation",
    "renderable",
    "scannable",
    "scratchpad",
    "Skimmable",
    "standfirst",
    "stdlib",
    "stringly",
    "Typst",
    "unactivated",
    "unlinkable",
