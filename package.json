{
  "name": "@casomoltd/tooling",
  "version": "0.24.0",
  "description": "Casomo's shared dev config: ESLint, Prettier, commitlint, knip & jscpd presets and dev CLIs (git hooks, readability, screenshots)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/casomoltd/tooling.git"
  },
  "files": [
    "bin/",
    "eslint/",
    "prettier/",
    "commitlint/",
    "knip/",
    "jscpd/",
    "readability/",
    "report/",
    "README.md",
    "!**/*.test.mjs"
  ],
  "scripts": {
    "check": "node bin/check-gates.mjs && node bin/verify-pack.mjs && npm run check:private-refs && npm run typecheck && npm run test && npm run lint:md",
    "typecheck": "tsc --noEmit -p hooks/tsconfig.json",
    "test": "node hooks/test.mts && node bin/check-gates.test.mjs",
    "lint:md": "remark --frail --quiet --no-stdout --rc-path bin/skills-lint.config.mjs skills docs",
    "build": "echo 'no-op: source-only repo, nothing to build'",
    "prepare": "husky || true",
    "check:private-refs": "node bin/check-private-refs.mjs"
  },
  "casomo": {
    "gates": {
      "lint": "publishes the shared eslint config but has none of its own yet",
      "knip": "no knip config for this repo's mixed .mts/.mjs layout yet",
      "jscpd": "no jscpd config for this repo yet",
      "spell": "no shared cspell config exists yet",
      "build": "source-only repo — build is a deliberate no-op, nothing to verify"
    }
  },
  "exports": {
    "./eslint": "./eslint/index.mjs",
    "./eslint-lib": "./eslint/lib.mjs",
    "./prettier": "./prettier/index.js",
    "./commitlint": "./commitlint/index.cjs",
    "./knip": "./knip/index.json",
    "./jscpd": "./jscpd/index.json",
    "./readability": "./readability/index.mjs"
  },
  "bin": {
    "build-report": "./bin/build-report.mjs",
    "check-gates": "./bin/check-gates.mjs",
    "check-private-refs": "./bin/check-private-refs.mjs",
    "check-tags": "./bin/check-tags.sh",
    "check-version": "./bin/check-version.sh",
    "commit-msg": "./bin/commit-msg.sh",
    "pre-commit": "./bin/pre-commit.sh",
    "pre-push": "./bin/pre-push.sh",
    "readability": "./bin/readability.mjs",
    "screenshot": "./bin/screenshot.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "text-readability": "^1.1.1"
  },
  "peerDependencies": {
    "@commitlint/cli": ">=20",
    "eslint": ">=9",
    "eslint-config-next": ">=16",
    "eslint-plugin-sonarjs": ">=3",
    "jscpd": ">=4",
    "knip": ">=5"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "husky": "^9.1.7",
    "remark-cli": "^12.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-lint-frontmatter-schema": "^3.15.4",
    "remark-validate-links": "^13.1.0",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "remark-lint-frontmatter-schema": {
      "@apidevtools/json-schema-ref-parser": "^11.1.1",
      "ajv": "^8.18.0",
      "minimatch": "^9.0.7",
      "yaml": "^2.8.3"
    }
  }
}
