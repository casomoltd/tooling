{
  "name": "@casomoltd/tooling",
  "version": "0.46.0",
  "description": "Casomo's shared dev config: ESLint, Prettier, commitlint, knip & jscpd presets, dev CLIs (git hooks, readability, screenshots, design specs), and the build-time data and helpers sites import (the Buttondown engine, the shared Organization)",
  "author": "Casomo Ltd",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/casomoltd/tooling.git"
  },
  "files": [
    "bin/",
    "eslint/",
    "prettier/",
    "commitlint/",
    "knip/",
    "jscpd/",
    "readability/",
    "report/",
    "styles/",
    "buttondown/",
    "identity/",
    "tokens/",
    "attribution/",
    "tally/",
    "signature/",
    "hooks/lib/shapes.mjs",
    "hooks/lib/command-shapes.mjs",
    "hooks/lib/shapes.d.mts",
    "!hooks/README.md",
    "README.md",
    "!**/*.test.mjs",
    "!identity/tsconfig.json",
    "!tally/tsconfig.json",
    "!tally/tsconfig.browser.json",
    "!bin/tsconfig.json",
    "!tally/fixture.mjs",
    "!attribution/tsconfig.json",
    "!signature/tsconfig.json"
  ],
  "scripts": {
    "check": "node bin/check-gates.mjs && node bin/verify-pack.mjs && npm run check:private-refs && npm run check:personal-data && npm run lint && npm run typecheck && npm run test && npm run lint:md",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p hooks/tsconfig.json && tsc --noEmit -p bin/tsconfig.json && tsc --noEmit -p identity/tsconfig.json && tsc --noEmit -p tally/tsconfig.json && tsc --noEmit -p tally/tsconfig.browser.json && tsc --noEmit -p attribution/tsconfig.json && tsc --noEmit -p signature/tsconfig.json",
    "test": "node hooks/test.mts && node hooks/commit-detail.test.mts && node bin/commit-msg.test.mjs && node bin/check-gates.test.mjs && node bin/check-listed-files.test.mjs && node bin/check-personal-data.test.mjs && node bin/check-routes.test.mjs && node bin/casomo-config.test.mjs && node bin/buttondown.test.mjs && node buttondown/post-check.test.mjs && node commitlint/index.test.mjs && node readability/index.test.mjs && node identity/index.test.mjs && node tally/translator.test.mjs && node tally/compare.test.mjs && node tally/embed.test.mjs && node tally/frame.test.mjs && node tally/frame.dom.test.mjs && node attribution/index.test.mjs && node signature/rules.test.mjs && node bin/exports.test.mjs",
    "lint:md": "remark --frail --quiet --no-stdout --rc-path bin/skills-lint.config.mjs skills agents docs",
    "build": "echo 'no-op: source-only repo, nothing to build'",
    "prepare": "husky || true",
    "check:private-refs": "node bin/check-private-refs.mjs",
    "check:personal-data": "node bin/check-personal-data.mjs"
  },
  "casomo": {
    "gates": {
      "knip": "no knip config for this repo's mixed .mts/.mjs layout yet",
      "jscpd": "no jscpd config for this repo yet",
      "spell": "no shared cspell config exists yet",
      "build": "source-only repo — build is a deliberate no-op, nothing to verify"
    }
  },
  "exports": {
    "./eslint": "./eslint/index.mjs",
    "./eslint-lib": "./eslint/lib.mjs",
    "./prettier": "./prettier/index.js",
    "./commitlint": "./commitlint/index.cjs",
    "./knip": "./knip/index.json",
    "./jscpd": "./jscpd/index.json",
    "./readability": "./readability/index.mjs",
    "./buttondown": {
      "types": "./buttondown/index.d.mts",
      "default": "./buttondown/index.mjs"
    },
    "./banned-words": "./buttondown/banned-words.json",
    "./identity": {
      "types": "./identity/index.d.mts",
      "default": "./identity/index.mjs"
    },
    "./tally": {
      "types": "./tally/index.d.mts",
      "default": "./tally/index.mjs"
    },
    "./tally/paths": {
      "types": "./tally/paths.d.mts",
      "default": "./tally/paths.mjs"
    },
    "./tally/events": {
      "types": "./tally/events.d.mts",
      "default": "./tally/events.mjs"
    },
    "./signature": {
      "types": "./signature/index.d.mts",
      "default": "./signature/index.mjs"
    },
    "./tally/frame": {
      "types": "./tally/frame.d.mts",
      "default": "./tally/frame.mjs"
    },
    "./hooks/shapes": {
      "types": "./hooks/lib/shapes.d.mts",
      "default": "./hooks/lib/shapes.mjs"
    },
    "./attribution": {
      "types": "./attribution/index.d.mts",
      "default": "./attribution/index.mjs"
    }
  },
  "bin": {
    "build-report": "bin/build-report.mjs",
    "buttondown": "bin/buttondown.mjs",
    "check-gates": "bin/check-gates.mjs",
    "check-hooks": "bin/check-hooks.sh",
    "check-listed-files": "bin/check-listed-files.mjs",
    "check-linear": "bin/check-linear.sh",
    "check-personal-data": "bin/check-personal-data.mjs",
    "check-private-refs": "bin/check-private-refs.mjs",
    "check-routes": "bin/check-routes.mjs",
    "check-tags": "bin/check-tags.sh",
    "check-version": "bin/check-version.sh",
    "commit-msg": "bin/commit-msg.sh",
    "pre-commit": "bin/pre-commit.sh",
    "pre-push": "bin/pre-push.sh",
    "readability": "bin/readability.mjs",
    "render-figures": "bin/render-figures.mjs",
    "screenshot": "bin/screenshot.mjs",
    "spec-check": "bin/spec-check.mjs",
    "tally": "bin/tally.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "marked": "^18.0.13",
    "text-readability": "^1.1.1",
    "zod": "^4.4.1"
  },
  "peerDependencies": {
    "@commitlint/cli": ">=20",
    "eslint": ">=9.24",
    "eslint-config-next": ">=16",
    "eslint-plugin-sonarjs": ">=3",
    "jscpd": ">=4",
    "knip": ">=5",
    "next": ">=16",
    "react": ">=19.2",
    "typescript": ">=5"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^26.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remark-cli": "^12.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-lint-frontmatter-schema": "^3.15.4",
    "remark-validate-links": "^13.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "overrides": {
    "remark-lint-frontmatter-schema": {
      "@apidevtools/json-schema-ref-parser": "^11.1.1",
      "ajv": "^8.18.0",
      "minimatch": "^9.0.7",
      "yaml": "^2.8.3"
    }
  }
}
